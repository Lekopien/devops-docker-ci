// Cloudflare Worker (free plan) that serves the showcase site at https://devops.lekopien.com
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lekopien-devops",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./site" },
  "routes": [{ "pattern": "devops.lekopien.com", "custom_domain": true }]
}
